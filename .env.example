# x402 Ad Agent Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: Anthropic API (for AI-powered bidding)
# =============================================================================
# Get your API key from: https://console.anthropic.com/
BID_ANTHROPIC_API_KEY=sk-ant-api03-...

# =============================================================================
# REQUIRED: CDP Wallet (for Agent A - CDP Agent)
# =============================================================================
# Get credentials from: https://portal.cdp.coinbase.com/
# 1. Create a new API key
# 2. Save the API Key ID and API Key Secret
# 3. Generate a wallet secret (random string, keep it secure)

CDP_API_KEY_ID=your-api-key-id
CDP_API_KEY_SECRET=your-api-key-secret
CDP_WALLET_SECRET=your-wallet-secret

# Optional: Reuse existing CDP wallet account
# Leave empty to create a new wallet on first run
# After first run, the agent will log the account name to save here
# Example: agent-1730123456789
AGENT_A_CDP_WALLET_ID=

# =============================================================================
# REQUIRED: Crossmint Wallet (for Agent B - Crossmint Agent)
# =============================================================================
# Get credentials from: https://www.crossmint.com/console
# 1. Create a new API key (server-side)
# 2. Create a custodial wallet
# 3. Copy the wallet locator (format: email:user@example.com:base-sepolia)

AGENT_B_CROSSMINT_API_KEY=your-crossmint-api-key
AGENT_B_CROSSMINT_WALLET_LOCATOR=email:your-email@example.com:base-sepolia

# =============================================================================
# Optional: Agent Configuration
# =============================================================================
# Server URL (default: http://localhost:3000)
BID_SERVER_URL=http://localhost:3000

# Ad spot to bid on (default: homepage-banner-1)
AD_SPOT_ID=homepage-banner-1

# Agent names (defaults: CDP Agent, Crossmint Agent)
AGENT_A_NAME=CDP Agent
AGENT_B_NAME=Crossmint Agent

# Maximum bid amounts in USDC (defaults: 10, 15)
AGENT_A_MAX_BID=10
AGENT_B_MAX_BID=15
