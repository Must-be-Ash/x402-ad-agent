# ============================================
# X402 AD AUCTION - SERVER CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your values

# ============================================
# SERVER WALLET (REQUIRED)
# ============================================
# The server wallet handles payment settlements and refunds
# Generate with: node -e "const {generatePrivateKey, privateKeyToAccount} = require('viem/accounts'); const pk = generatePrivateKey(); console.log('Private Key:', pk); console.log('Address:', privateKeyToAccount(pk).address);"

# Server wallet private key (0x followed by 64 hex characters)
SERVER_WALLET_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Server wallet address (must match the private key above)
SERVER_WALLET_ADDRESS=0x1234567890AbcdEF1234567890aBcdef12345678

# ============================================
# COINBASE CDP (OPTIONAL)
# ============================================
# Required only if you want to use CDP for wallet management
# Get credentials from: https://portal.cdp.coinbase.com/
# Leave commented out if using raw private key above

# CDP_API_KEY_ID=organizations/your-org-id/apiKeys/your-key-id
# CDP_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----\nYourSecretHere\n-----END EC PRIVATE KEY-----
# CDP_WALLET_SECRET=your-wallet-secret

# ============================================
# DATABASE (OPTIONAL)
# ============================================
# MongoDB connection for persistent storage
# If not set, uses in-memory storage (data lost on restart)
# Get free MongoDB at: https://www.mongodb.com/cloud/atlas

# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
# MONGODB_DB_NAME=x402-auction

# ============================================
# AUCTION PARAMETERS (OPTIONAL)
# ============================================
# Customize auction behavior

# How long each auction runs (in minutes)
AUCTION_DURATION_MINUTES=5

# Starting bid amount in USDC
STARTING_BID_USDC=1

# Minimum increment for each new bid in USDC
BID_INCREMENT_USDC=1

# ============================================
# X402 PROTOCOL (OPTIONAL)
# ============================================
# x402 facilitator URL for payment verification
# Default works for most cases
FACILITATOR_URL=https://x402.org/facilitator
