# ============================================
# X402 AD AUCTION - AGENT CONFIGURATION
# ============================================
# Copy this file to agents/.env and fill in your values

# ============================================
# AGENT A WALLET (REQUIRED)
# ============================================
# Agent A's wallet for bidding
# Generate with: node -e "const {generatePrivateKey, privateKeyToAccount} = require('viem/accounts'); const pk = generatePrivateKey(); console.log('Private Key:', pk); console.log('Address:', privateKeyToAccount(pk).address);"

# Agent A private key
AGENT_A_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Agent A display name (appears in UI and logs)
AGENT_A_NAME=IceCo

# Agent A maximum bid in USDC (agent won't bid above this)
AGENT_A_MAX_BID=10

# ============================================
# AGENT B WALLET (REQUIRED)
# ============================================
# Agent B's wallet for bidding

# Agent B private key
AGENT_B_PRIVATE_KEY=0xabcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890

# Agent B display name
AGENT_B_NAME=FizzUp

# Agent B maximum bid in USDC
AGENT_B_MAX_BID=15

# ============================================
# AI CONFIGURATION (REQUIRED for intelligent agents)
# ============================================
# Anthropic API key for Claude AI decision-making
# Get from: https://console.anthropic.com/
# Note: The BID_ prefix avoids conflicts with other Anthropic projects

BID_ANTHROPIC_API_KEY=sk-ant-api03-1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# ============================================
# SERVER CONNECTION (REQUIRED)
# ============================================
# URL where your Next.js server is running
BID_SERVER_URL=http://localhost:3000

# Which ad spot to bid on (must match the spot ID in the server)
AD_SPOT_ID=demo-spot-1

# ============================================
# ANALYTICAL AGENTS (OPTIONAL)
# ============================================
# For agents that scrape and analyze websites before bidding
# Tunnel URL exposes localhost to external services (like Firecrawl)
# Example: Cloudflare Tunnel, ngrok, localhost.run

# TUNNEL_URL=https://your-tunnel-subdomain.trycloudflare.com
